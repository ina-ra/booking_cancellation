POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_DB=booking_cancellation
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

DEFAULT_HIGH_RISK_THRESHOLD=0.7
DEFAULT_BATCH_RISK_SHARE=0.3
RANDOM_STATE=42
TEST_SIZE=0.2

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=booking-cancellation-artifacts
S3_ACCESS_KEY=booking_minio
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_ARTIFACTS_PREFIX=artifacts
S3_BATCH_OUTPUTS_PREFIX=batch-runs
S3_AUTO_CREATE_BUCKET=true
S3_USE_PATH_STYLE=true

MINIO_ROOT_USER=booking_minio
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_PORT=8081
APP_PORT=8000
